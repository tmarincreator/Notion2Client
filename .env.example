# Notion2Client · variables de entorno
# Copia este archivo a .env.local y rellénalo. En el hosting, ponlas en su panel.
# El servidor comprueba al arrancar que están todas (instrumentation.ts).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta: solo en el servidor, nunca con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Firma las cookies de acceso de los clientes a los portales (32+ caracteres aleatorios).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_SECRET=

# Cifra los tokens de Notion de las agencias (32 bytes en base64).
# Si la cambias, cada agencia tendrá que volver a pegar su token en Ajustes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOTION_TOKEN_KEY=

# Dirección pública de la web (enlaces de los correos). Obligatoria en producción;
# en desarrollo, si falta, se usa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://tudominio.com
